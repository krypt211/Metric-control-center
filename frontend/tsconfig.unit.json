{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "plugins": []
  },
  "include": [
    "lib/column-model.ts",
    "lib/metric-registry.ts",
    "components/StatisticsTable.tsx",
    "lib/reporting-period.ts",
    "components/SourceSummary.tsx",
    "components/ProviderCapabilities.tsx"
  ],
  "exclude": [
