# Public configuration only; secrets are files in .secrets/.
APP_DOMAIN=stats.example.com
ACME_EMAIL=admin@example.com
MCC_IMAGE_TAG=local
POSTGRES_DB=metric_control
POSTGRES_USER=metric_control
WORKSPACE_ID=default
SYNC_TIMEZONE=Europe/Moscow
SESSION_TTL_SECONDS=28800
BACKUP_RETENTION_DAYS=14
# Enable after real HTTPS verification.
HSTS_MAX_AGE=0
AUTH_ENABLED=true
LOCAL_READ_ONLY=true
SYNC_ENABLED=true
SYNC_DAILY_BUDGET=800
ACTIONS_ENABLED=false
AI_ENABLED=false
AI_AUTOPILOT_ALLOWED=false
TELEGRAM_ENABLED=false
