# No API keys here. Copy to .env for local Docker configuration.
POSTGRES_DB=metric_control
POSTGRES_USER=metric_control
# Backend is bound to localhost until authentication is implemented.
BACKEND_PORT=8000
FRONTEND_PORT=3000
WORKSPACE_ID=default
LOCAL_READ_ONLY=true
SYNC_ENABLED=true
SYNC_DAILY_BUDGET=800
SYNC_TIMEZONE=Europe/Moscow
ACTIONS_ENABLED=false
ACTION_OPERATOR_ID=local-operator
ACTION_MAX_BUDGET=10000
ACTION_MAX_CHANGE_PERCENT=20
AI_ENABLED=false
AI_AUTOPILOT_ALLOWED=false
# Set an explicitly chosen Responses API model before enabling inference.
OPENAI_MODEL=
TELEGRAM_ENABLED=false

AUTH_ENABLED=true
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
SESSION_TTL_SECONDS=28800
BACKUP_RETENTION_DAYS=14

# Future dedicated action-process vault only; do not mount in READ services.
# No provider WRITE key is provisioned automatically. Internal cipher is prepared by deployment.
# METRICFLOW_WRITE_VAULT_FILE=/vault-namespace/metricflow-write
# This is an envelope namespace; encrypted WRITE records stay in PostgreSQL.
# No plaintext METRICFLOW_WRITE_KEY_FILE or file-vault fallback is supported.
# METRICFLOW_WRITE_ENCRYPTION_KEY_FILE=/run/secrets/metricflow_write_encryption_key

# Separate private credential management service; never enables advertising WRITE.
CREDENTIAL_MANAGEMENT_ENABLED=true

# Meta durable READ lifecycle only; does not enable Meta or change daily cap.
META_JOB_TTL_TODAY_SECONDS=540
META_JOB_TTL_YESTERDAY_SECONDS=3300
META_JOB_TTL_LAST7_SECONDS=82800
META_JOB_TTL_MANUAL_SECONDS=1800
META_JOB_TTL_HEALTH_SECONDS=300
META_MANUAL_DEDUP_SECONDS=60
META_JOB_LEASE_SECONDS=240
META_JOB_QUEUE_LIMIT=20

# Preparation only. Keep session authorization empty until separate approval.
META_CONTROLLED_READ_PILOT=true
META_PILOT_AUTHORIZED_SESSION_ID=
META_PILOT_CONFIRMED_GRAPH_VERSION=
