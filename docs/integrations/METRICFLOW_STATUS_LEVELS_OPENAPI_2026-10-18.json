              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "Entity Actions"
        ],
        "summary": "Action job status",
        "description": "Poll the state of a single- or bulk-entity action job queued via `?async=true` on any `POST /api/v1/entities/.../{pause|enable|budget|bid|bid-strategy}` endpoint, via `POST /api/v1/entities/bulk/status`, or a creative edit via `POST /api/v1/entities/{id}/edit` / `bulk/edit` (action_type=`edit`). Status progresses through pending → running → success / partial / failed / expired. Per-entity outcomes appear in `results` once the worker finishes (or partially finishes) the job.",
        "operationId": "api_action_job_status_api_v1_jobs__job_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityActionJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
