  "paths": {
    "/api/v1/entities/{entity_id}/pause": {
      "post": {
        "tags": [
          "Entity Actions"
        ],
        "summary": "Pause entity",
        "description": "Pause a campaign / adset / ad.\n\n**Recommended:** pass `?async=true` (default for new integrations) to enqueue the action on the worker and get an immediate 202 with a `job_id`. Poll `GET /api/v1/jobs/{job_id}` for completion. The synchronous path (default for backward compatibility) blocks until Facebook responds — calls can take 30+ s under FB rate-limit pressure and may time out client-side.",
        "operationId": "api_pause_entity_api_v1_entities__entity_id__pause_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Entity Id"
            }
          },
          {
            "name": "async",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "If true, enqueue the action and return 202 + job_id.",
              "default": false,
              "title": "Async"
            },
            "description": "If true, enqueue the action and return 202 + job_id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/entities/{entity_id}/enable": {
      "post": {
        "tags": [
          "Entity Actions"
        ],
        "summary": "Enable entity",
        "description": "Enable a paused campaign / adset / ad. Pass `?async=true` to enqueue and get an immediate 202 + `job_id` (recommended). Poll via `GET /api/v1/jobs/{job_id}`.",
        "operationId": "api_enable_entity_api_v1_entities__entity_id__enable_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Entity Id"
            }
          },
          {
            "name": "async",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "If true, enqueue and return 202 + job_id.",
              "default": false,
              "title": "Async"
            },
            "description": "If true, enqueue and return 202 + job_id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
